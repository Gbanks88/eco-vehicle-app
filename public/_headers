/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self' 'unsafe-inline' 'unsafe-eval' *.netlify.app *.cg4l.online *.johnallens.com; img-src 'self' data: https: *.cloudinary.com; media-src 'self' https:; connect-src 'self' https:; frame-src 'self' https://sketchfab.com https://youtube.com;
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-XSS-Protection: 1; mode=block
  Cache-Control: public, max-age=3600

# Eco-Vehicle site specific
/ev/*
  Cache-Control: public, max-age=3600
  Access-Control-Allow-Origin: https://cg4l.online

/3d/*
  Cache-Control: public, max-age=3600
  Access-Control-Allow-Origin: https://cg4l.online

/tech/*
  Cache-Control: public, max-age=3600
  Access-Control-Allow-Origin: https://cg4l.online

/charging/*
  Cache-Control: no-cache
  Access-Control-Allow-Origin: https://cg4l.online

/parts/*
  Cache-Control: public, max-age=3600
  Access-Control-Allow-Origin: https://cg4l.online

/service/*
  Cache-Control: no-cache
  Access-Control-Allow-Origin: https://cg4l.online

# Fashion site specific
/mens/*
  Cache-Control: public, max-age=3600
  Access-Control-Allow-Origin: https://johnallens.com

/womens/*
  Cache-Control: public, max-age=3600
  Access-Control-Allow-Origin: https://johnallens.com

/shop/*
  Cache-Control: no-cache
  Access-Control-Allow-Origin: https://johnallens.com
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self' 'unsafe-inline' 'unsafe-eval' *.netlify.app *.cg4l.online *.johnallens.com; img-src 'self' data: https:; media-src 'self' https:; connect-src 'self' https:;
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-XSS-Protection: 1; mode=block
  Cache-Control: public, max-age=31536000

# API endpoints
/api/*
  Cache-Control: no-cache
  Access-Control-Allow-Origin: https://cg4l.online https://johnallens.com
  Access-Control-Allow-Methods: GET, POST, OPTIONS
  Access-Control-Allow-Headers: Content-Type, Authorization

# CDN content
/cdn-content/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self' https://johnallens.com https://www.amazon.com; script-src 'self' 'unsafe-eval' 'unsafe-inline' https://www.amazon.com https://johnallens.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https: https://www.amazon.com https://johnallens.com; connect-src 'self' https://www.amazon.com https://johnallens.com; frame-src https://www.amazon.com https://johnallens.com
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
